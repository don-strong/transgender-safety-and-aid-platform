<?xml version="1.0" encoding="UTF-8"?>

<!--
    Register.fxml
    Implemented by @sixplanet312 (Justin Brown)

    Description:
    Defines the layout and UI controls for the Account Registration Page
    of the Trans Safety application. Provides input fields for creating 
    a new user account and includes navigation back to the Login page.

    Features:
    - Username, email, and confirm email input fields
    - Password and confirm password fields
    - Register button for submitting account creation
    - Error label for displaying validation issues
    - Navigation button to return to Login page

    Controller:
    - io.transsafety.RegisterController
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.transsafety.RegisterController"
      alignment="CENTER"
      spacing="12">

    <Label text="Create a New Account"
           style="-fx-font-size: 22px; -fx-font-weight: bold;" />

    <!-- Username input field -->
    <TextField fx:id="usernameField"
               promptText="Username"
               maxWidth="260"
               focusTraversable="true"/>

    <!-- Email input field -->
    <TextField fx:id="emailField"
               promptText="Email"
               maxWidth="260"/>

    <!-- Email confirmation input field -->
    <TextField fx:id="confirmEmailField"
               promptText="Confirm Email"
               maxWidth="260"/>

    <!-- Password input field (masked for security) -->
    <PasswordField fx:id="passwordField"
                   promptText="Password"
                   maxWidth="260"/>

    <!-- Password confirmation input field -->
    <PasswordField fx:id="confirmPasswordField"
                   promptText="Confirm Password"
                   maxWidth="260"/>

    <!-- Submits the registration form -->
    <Button text="Register"
            maxWidth="260"
            onAction="#handleRegister"/>

    <!-- Displays validation or registration error messages -->
    <Label fx:id="errorLabel"
           textFill="red"
           wrapText="true"
           maxWidth="260"
           style="-fx-font-size: 12px;" />

    <!-- Navigates back to the login screen -->
    <Button text="Back to Login"
            maxWidth="260"
            onAction="#handleBackToLogin"/>

    <!-- Padding around the registration form -->
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

</VBox>

