<?xml version="1.0" encoding="UTF-8"?>

<!--
    UserQuery.fxml
    Implemented by @sixplanet312 (Justin Brown) & @aaron-alaman

    Description:
    Defines the layout and UI for the User Query Page of the Trans Safety
    application. Provides tools for searching local businesses, viewing
    database results, reading user reviews, and submitting new reviews.

    Features:
    - Search fields for business name, city, and business type
    - Search and Clear buttons for filtering query results
    - Scrollable window displaying matching businesses
    - Scrollable window showing user-submitted reviews
    - Review submission section with text input and rating selector
    - Navigation button to return to the Login page

    Controller:
    - io.transsafety.UserQueryController
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.Integer?>

<!--
 Root layout container
 BorderPane is used to separate navigation (top) and main content (center)
-->
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.transsafety.UserQueryController">

    <!-- Top navigation bar -->
    <top>
        <HBox alignment="CENTER">

            <!-- Padding for navigation area -->
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <!-- Returns the user to the login screen -->
            <Button text="Back to Login"
                    onAction="#onBackToLogin"
                    maxWidth="150"/>
        </HBox>
    </top>

    <!-- Main content area -->
    <center>
        <VBox spacing="20">

            <!-- Padding around the main content -->
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Search/filter input section -->
            <VBox fx:id="searchWindow"
                  prefHeight="100"
                  spacing="10"
                  style="-fx-border-color: black;
                         -fx-border-width: 1;
                         -fx-padding: 10;
                         -fx-background-color: #f4f4f4;">

                <!-- Business name search -->
                <Label text="Name:" />
                <TextField fx:id="searchNameField"
                           promptText="Enter business name"/>

                <!-- City-based search -->
                <Label text="City:" />
                <TextField fx:id="searchCityField"
                           promptText="Enter city"/>

                <!-- Business type filter -->
                <Label text="Business Type:" />
                <ComboBox fx:id="businessTypeBox"
                          promptText="Select a type"/>

                <!-- Search and clear actions -->
                <HBox spacing="10">
                    <Button text="Search"
                            fx:id="searchButton"
                            onAction="#onSearchClicked"/>

                    <Button text="Clear"
                            fx:id="clearButton"
                            onAction="#onClearClicked"/>
                </HBox>

            </VBox>

            <!-- Scrollable business results display -->
            <ScrollPane fitToWidth="true" fitToHeight="true">

                <VBox fx:id="businessWindow"
                      spacing="10"
                      style="-fx-border-color: black;
                             -fx-border-width: 2;
                             -fx-padding: 10;"
                      prefHeight="300">

                    <!-- Business results header -->
                    <Label text="Business Database Window"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                </VBox>
            </ScrollPane>

            <!-- Scrollable user reviews display -->
            <ScrollPane fitToWidth="true" fitToHeight="true">

                <VBox fx:id="reviewsWindow"
                      spacing="10"
                      style="-fx-border-color: black;
                             -fx-border-width: 2;
                             -fx-padding: 10;"
                      prefHeight="300">

                    <!-- Reviews section header -->
                    <Label text="User Reviews Window"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                </VBox>
            </ScrollPane>

            <!-- Review submission section -->
            <VBox fx:id="reviewSubmitWindow"
                  spacing="10"
                  style="-fx-border-color: black;
                         -fx-border-width: 1;
                         -fx-padding: 10;
                         -fx-background-color: #f4f4f4;">

                <!-- Review input header -->
                <Label text="Submit a Review:" />

                <!-- Text input for review content -->
                <TextField fx:id="reviewInput"
                           promptText="Enter your review here"/>

                <!-- Rating selection -->
                <Label text="Rating:" />

                <!-- Dropdown for selecting a rating (1–5) -->
                <ComboBox fx:id="reviewRatingBox">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <Integer fx:value="1"/>
                            <Integer fx:value="2"/>
                            <Integer fx:value="3"/>
                            <Integer fx:value="4"/>
                            <Integer fx:value="5"/>
                        </FXCollections>
                    </items>
                </ComboBox>

                <Button text="Submit Review"
                        onAction="#onSubmitReview"/>

            </VBox>

        </VBox>
    </center>
</BorderPane>

