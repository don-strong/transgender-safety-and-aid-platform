<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.transsafety.UserQueryController">

    <top>
        <HBox alignment="CENTER">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button text="Back to Login"
                    onAction="#onBackToLogin"
                    maxWidth="150"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <VBox fx:id="searchWindow"
                  prefHeight="100"
                  spacing="10"
                  style="-fx-border-color: black;
                         -fx-border-width: 1;
                         -fx-padding: 10;
                         -fx-background-color: #f4f4f4;">

                <Label text="Name:" />
                <TextField fx:id="searchNameField"
                           promptText="Enter business name"/>

                <Label text="City:" />
                <TextField fx:id="searchCityField"
                           promptText="Enter city"/>

                <Label text="Business Type:" />
                <ComboBox fx:id="businessTypeBox"
                          promptText="Select a type"/>

                <HBox spacing="10">
                    <Button text="Search" fx:id="searchButton" onAction="#onSearchClicked"/>
                    <Button text="Clear" fx:id="clearButton" onAction="#onClearClicked"/>
                </HBox>
                
            </VBox>

            <ScrollPane fitToWidth="true" fitToHeight="true">
                <VBox fx:id="businessWindow"
                      spacing="10"
                      style="-fx-border-color: black;
                             -fx-border-width: 2;
                             -fx-padding: 10;"
                      prefHeight="300">
                    <Label text="Business Database Window"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                </VBox>
            </ScrollPane>

            <ScrollPane fitToWidth="true" fitToHeight="true">
                <VBox fx:id="reviewsWindow"
                      spacing="10"
                      style="-fx-border-color: black;
                             -fx-border-width: 2;
                             -fx-padding: 10;"
                      prefHeight="300">
                    <Label text="User Reviews Window"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                </VBox>
            </ScrollPane>

            <VBox fx:id="reviewSubmitWindow"
                  spacing="10"
                  style="-fx-border-color: black;
                         -fx-border-width: 1;
                         -fx-padding: 10;
                         -fx-background-color: #f4f4f4;">

                <Label text="Submit a Review:" />
                <TextField fx:id="reviewInput"
                           promptText="Enter your review here"/>

                <Button text="Submit Review" onAction="#onSubmitReview"/>
            </VBox>
       </VBox>
    </center>

</BorderPane>
